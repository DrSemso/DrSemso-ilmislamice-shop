# Supabase (Project settings -> API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only key, never expose to the browser
SUPABASE_SERVICE_ROLE_KEY=

# Public address of the shop, used in emails
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Order emails via Resend (https://resend.com). Without a key, emails are skipped and logged.
RESEND_API_KEY=
EMAIL_FROM="ILM e-islamic shop <narudzbe@example.com>"
# Where new-order notifications go (shop owner)
OWNER_EMAIL=

# Comma-separated emails that get admin access at /admin
ADMIN_EMAILS=

# Optional: AI answers in the chat widget (Claude). Without a key the widget answers from the FAQ.
ANTHROPIC_API_KEY=
